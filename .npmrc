registry=https://registry.npmjs.org/
auto-install-peers=true
strict-peer-dependencies=false
enable-pre-post-scripts=true
node-linker=hoisted
shamefully-hoist=true
store-dir=./.pnpm-store
cache-dir=./.pnpm-cache
state-dir=./.pnpm-state

# Hoist tooling CLIs to the root. Windows pnpm package-local .bin/*.cmd shims
# often point at packages/<pkg>/node_modules/<tool>/... which is missing when
# the tool is only at the repo root; scripts use scripts/run-bin.mjs as a fallback.
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*tsup*
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*vitest*
public-hoist-pattern[]=*rimraf*
