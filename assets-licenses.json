        "commercialUse": true,
        "redistribution": true,
        "modification": true,
        "credit": false,
        "prohibited": ["hate speech / discrimination", "antisocial or illegal use"]
      }
    },
    "LicenseRef-VRM-Public-1.0": {
      "name": "VRM Public License 1.0",
      "url": "https://vrm.dev/licenses/1.0/",
      "perModelConditions": true,
      "requires": {
        "commercialUse": true,
        "redistribution": true
      }
    }
  },
