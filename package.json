{
  "name": "ig-live-monorepo",
  "version": "1.0.0",
  "description": "基于 Electron 的看板娘桌面应用 + AI Harness（dsh）",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:models": "node scripts/generate-model-list.cjs",
    "prebuild": "npm run generate:models",
    "predev": "npm run generate:models",
    "dev": "turbo run dev",
    "start": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:renderer": "turbo run build --filter=@ig-live/renderer",
    "build:electron": "turbo run build --filter=@ig-live/electron",
    "package": "turbo run package",
    "package:prod": "turbo run package:prod",
    "package:prod:mac": "turbo run package:prod:mac",
    "package:prod:win": "turbo run package:prod:win",
    "package:prod:linux": "turbo run package:prod:linux",
    "package:debug": "turbo run package:debug",
    "package:debug:mac": "turbo run package:debug:mac",
    "package:debug:win": "turbo run package:debug:win",
    "package:debug:linux": "turbo run package:debug:linux",
    "test": "turbo run test && pnpm run test:root",
    "test:root": "vitest run --config vitest.root.config.ts scripts/__tests__",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:pkg": "turbo run test:e2e",
    "test:e2e:headed": "playwright test --config playwright.config.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "doctor": "tsx scripts/dsh-doctor.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "prepare": "husky"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-app-boot": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "@ig-live/ai-runtime": "workspace:*",
    "@ig-live/ai-sdk": "workspace:*",
    "@ig-live/ai-sdk-client": "workspace:*",
    "@ig-live/bundle-ig-base": "workspace:*",
    "@ig-live/bundle-ig-electron-caps": "workspace:*",
    "@ig-live/bundle-ig-live2d": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.14.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
