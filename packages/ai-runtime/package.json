{
  "name": "@ig-live/ai-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Electron \u4e3b\u8fdb\u7a0b\u8fd0\u884c\u65f6\uff1aIgPluginHost + Vercel AI SDK Booter + AIClient + IPC + \u53ef\u9009 dsh",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@ig-live/ai-sdk": "workspace:*",
    "@ig-live/bundle-ig-base": "workspace:*",
    "@ig-live/bundle-ig-electron-caps": "workspace:*",
    "electron": ">=28"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ig-live/ai-sdk": "workspace:*",
    "@ig-live/bundle-ig-base": "workspace:*",
    "@ig-live/bundle-ig-electron-caps": "workspace:*",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ai": "^7.0.136",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/deepseek": "^3.0.63",
    "zod": "^4.6.5"
  }
}
