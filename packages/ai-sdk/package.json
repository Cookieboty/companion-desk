{
  "name": "@ig-live/ai-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "AI SDK 门面（环境无关）：AIClient + 7 Facade + DTO + zod 校验，屏蔽 dsh 表面变动",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.2-alpha.3",
    "@ig-live/bundle-ig-base": "workspace:*",
    "@ig-live/bundle-ig-live2d": "workspace:*",
    "@ig-live/bundle-ig-electron-caps": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@ig-live/bundle-ig-live2d": {
      "optional": true
    },
    "@ig-live/bundle-ig-electron-caps": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ig-live/bundle-ig-base": "workspace:*",
    "@ig-live/bundle-ig-electron-caps": "workspace:*",
    "@ig-live/bundle-ig-live2d": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
