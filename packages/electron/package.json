{
  "name": "@ig-live/electron",
  "version": "1.0.0",
  "description": "Electron主进程和预加载脚本",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \" tsc -w\" \"cross-env NODE_ENV=development electron .\"",
    "prebuild": "npm run clean",
    "build": "tsc ",
    "copy-renderer": "node scripts/copy-renderer.js",
    "clean": "rimraf dist",
    "package": "npm run copy-renderer && npm run package:prod",
    "package:prod": "electron-builder build",
    "package:prod:mac": "electron-builder build --mac",
    "package:prod:win": "electron-builder build --win",
    "package:debug": "cross-env DEBUG=true electron-builder build --config.asar=false -c.extraMetadata.debug=true",
    "package:debug:mac": "cross-env DEBUG=true electron-builder build --mac --config.asar=false -c.extraMetadata.debug=true",
    "package:debug:win": "cross-env DEBUG=true electron-builder build --win --config.asar=false -c.extraMetadata.debug=true",
    "launch:debug": "electron . --debug-mode",
    "mcp:start": "node dist/mcp-server.js",
    "mcp:debug": "node --inspect dist/mcp-server.js --debug",
    "mcp:standalone": "node dist/standalone-mcp-server.js",
    "mcp:standalone:debug": "node --inspect dist/standalone-mcp-server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "node-global-key-listener": "^0.3.0"
  },
  "devDependencies": {
    "@ig-live/types": "workspace:*",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "25.9.8",
    "electron-builder": "^23.6.0",
    "electron-reload": "2.0.0-alpha.1",
    "fs-extra": "^11.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^4.9.0",
    "wait-on": "^7.0.1",
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0"
  },
  "build": {
    "appId": "com.ig-live.electron",
    "productName": "智能小助手",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/standalone-mcp-server.js",
      "**/mcp/**/*"
    ],
    "extraResources": [
      {
        "from": "../renderer/dist",
        "to": "renderer"
      },
      {
        "from": "../renderer/tts-config.html",
        "to": "renderer/tts-config.html"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "../../dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "icon": "assets/logo.jpg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo.jpg"
    },
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "protocols": [
      {
        "name": "智能小助手",
        "schemes": [
          "ai-live"
        ]
      }
    ]
  }
}