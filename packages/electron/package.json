{
  "name": "@nomi-ai/electron",
  "version": "1.0.0",
  "description": "Electron主进程和预加载脚本",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run clean",
    "build": "node ../../scripts/run-bin.mjs tsc && node scripts/bundle-preload.mjs",
    "copy-renderer": "node scripts/copy-renderer.js",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist",
    "package": "npm run copy-renderer && npm run package:prod",
    "package:prod": "electron-builder build --publish never",
    "package:prod:mac": "electron-builder build --mac --publish never",
    "package:prod:win": "electron-builder build --win --publish never",
    "package:prod:linux": "electron-builder build --linux --publish never",
    "package:debug": "npm run copy-renderer && cross-env DEBUG=true electron-builder build --config.asar=false -c.extraMetadata.debug=true",
    "package:debug:mac": "npm run copy-renderer && cross-env DEBUG=true electron-builder build --mac --config.asar=false -c.extraMetadata.debug=true",
    "package:debug:win": "npm run copy-renderer && cross-env DEBUG=true electron-builder build --win --config.asar=false -c.extraMetadata.debug=true",
    "package:debug:linux": "npm run copy-renderer && cross-env DEBUG=true electron-builder build --linux --config.asar=false -c.extraMetadata.debug=true",
    "launch:debug": "electron . --debug-mode",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e --passWithNoTests",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "package:publish": "electron-builder build --publish always",
    "package:publish:mac": "electron-builder build --mac --publish always",
    "package:publish:win": "electron-builder build --win --publish always",
    "package:publish:linux": "electron-builder build --linux --publish always"
  },
  "author": "Cookieboty",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@nomi-ai/ai-runtime": "workspace:*",
    "@nomi-ai/ai-sdk": "workspace:*",
    "@nomi-ai/ai-sdk-client": "workspace:*",
    "@nomi-ai/bundle-ig-base": "workspace:*",
    "@nomi-ai/bundle-ig-electron-caps": "workspace:*",
    "@nomi-ai/bundle-ig-mascot": "workspace:*",
    "@nomi-ai/types": "workspace:*",
    "ai": "^7.0.136",
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.3",
    "node-global-key-listener": "^0.3.0",
    "onnxruntime-web": "1.30.0",
    "tesseract.js": "7.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "desktopName": "nomi.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cookieboty/nomi-ai.git"
  },
  "homepage": "https://github.com/Cookieboty/nomi-ai"
}
