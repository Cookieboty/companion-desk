{
  "name": "@nomi-ai/voice",
  "version": "0.1.0",
  "private": true,
  "description": "Nomi 语音输入：麦克风采集、Silero VAD、唤醒词匹配、按住说话 / 免按键控制器与 UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/voice.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/run-bin.mjs tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "clean": "node ../../scripts/run-bin.mjs rimraf dist",
    "typecheck": "node ../../scripts/run-bin.mjs tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-bin.mjs vitest run"
  },
  "dependencies": {
    "@nomi-ai/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
