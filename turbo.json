{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.dom.json",
    "tsup.base.ts",
    "vitest.base.ts",
    "eslint.config.mjs",
    ".prettierrc",
    ".npmrc",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [],
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsup.config.ts",
        "vite.config.ts",
        "vite.config.mts"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "eslint.config.mjs",
        "../../eslint.config.mjs"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**", "vitest.config.ts", "vitest.config.mts", "package.json"]
    },
    "@nomi-ai/electron#package": {
      "cache": false,
      "dependsOn": ["@nomi-ai/electron#build", "@nomi-ai/renderer#build", "@nomi-ai/ai-chat#build"]
    },
    "package:prod:mac": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:prod:win": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:prod:linux": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "package:debug": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
