{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.dom.json",
    "tsup.base.ts",
    "vitest.base.ts",
    "eslint.config.mjs",
    ".prettierrc",
    ".npmrc",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsup.config.ts",
        "vite.config.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "eslint.config.mjs",
        "../../eslint.config.mjs"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "vitest.config.mts",
        "package.json"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@ig-live/electron#package": {
      "cache": false,
      "dependsOn": ["@ig-live/electron#build", "@ig-live/renderer#build"]
    },
    "@ig-live/renderer#package": {
      "cache": false,
      "dependsOn": ["@ig-live/renderer#build"]
    },
    "@ig-live/types#package": {
      "cache": false,
      "dependsOn": ["@ig-live/types#build"]
    },
    "package:prod": { "cache": false, "dependsOn": ["build"] },
    "package:prod:mac": { "cache": false, "dependsOn": ["build"] },
    "package:prod:win": { "cache": false, "dependsOn": ["build"] },
    "package:debug": { "cache": false, "dependsOn": ["build"] },
    "package:debug:mac": { "cache": false, "dependsOn": ["build"] },
    "package:debug:win": { "cache": false, "dependsOn": ["build"] }
  }
}
